{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; form-action 'self' https://www.payhere.lk https://sandbox.payhere.lk"
	}
	# API + webhooks + uploads. flush_interval -1 keeps Server-Sent Events unbuffered.
	handle /api/* {
		reverse_proxy api:4000 { flush_interval -1 }
	}
	handle {
		reverse_proxy web:3000
	}
}
