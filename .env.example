# --- Core ---
# "buyer-seller" (default): buyers and sellers only. "full": also the venue-side platform (partner/admin portals, primary inventory, buyback).
# APP_PHASE=buyer-seller
# Operator endpoint (/api/ops) — stands in for an admin portal. Unset => endpoint disabled.
# OPS_TOKEN=generate-a-long-random-token
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_URL=http://localhost:3000
# Banner + "demo accounts" panel. Set to "false" in production.
NEXT_PUBLIC_SANDBOX=true

# --- Database ---
# Unset => embedded Postgres (PGlite, in-memory, auto-seeded with Melbourne demo data).
# Set   => any Postgres / Supabase connection string. Run `npm run db:migrate` first.
# DATABASE_URL=postgres://user:pass@host:5432/postgres
# SEED_DEMO=true            # seed demo data into an empty DATABASE_URL database (never in production)

# --- Payments (Stripe Connect). Unset => clearly-labelled sandbox provider. ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Notifications. Unset => written to the in-app notification centre + server log only. ---
# RESEND_API_KEY=...
# EMAIL_FROM="Eleventh Hour <hello@your-domain.example>"
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+61...

# --- Background jobs ---
# Secret for GET/POST /api/cron/maintenance (Vercel Cron / Supabase pg_cron / any scheduler)
CRON_SECRET=change-me
